# Secrets and local data: the .env and certs/ are mounted at runtime, never built in.
.env
.env.*
!.env.example
certs
database/*.sqlite*
**/*.xlsx

# Installed or generated inside the image.
vendor
node_modules
bootstrap/cache/*.php
public/storage
public/hot

# Local uploads, sessions, compiled views and logs.
storage/app/public/*
!storage/app/public/.gitignore
storage/app/private/*
!storage/app/private/.gitignore
storage/framework/cache/data
storage/framework/sessions/*
storage/framework/testing
storage/framework/views/*
storage/logs/*
storage/pail

# Development only (and the sources of the user guide; its PDFs in docs/ are served by the user menu).
.git
docs/.guide-src
.claude
.codex
.cursor
.idea
.vscode
.phpunit.cache
.phpunit.result.cache
tests
phpunit.xml
Dockerfile
docker-compose.yml
.dockerignore
