APP_NAME="Employee Satisfaction Survey"
APP_ENV=local
APP_KEY=
# Always false in production.
APP_DEBUG=true
APP_URL=http://localhost:26113
APP_TIMEZONE=Asia/Jakarta
# Host port of the Docker container (docker-compose.yml).
APP_PORT=26113
# Port of "php artisan serve": the same address as Docker, so run one of them at a time.
SERVER_PORT=26113

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Merdeka internal monitoring (activity_logs / error_logs tables)
LOG_ACTIVITY_ENABLED=true
LOG_ERRORS_TO_DATABASE=true

# SQLite works out of the box; SQL Server (sqlsrv, port 1433), MySQL/MariaDB and
# PostgreSQL are supported too.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lara_satisfaction
# DB_USERNAME=root
# DB_PASSWORD=
# SQL Server through ODBC Driver 18 (Docker) checks the server certificate;
# true accepts the server's own (self-signed) certificate. DB_ENCRYPT=yes|no.
# DB_TRUST_SERVER_CERTIFICATE=true
# DB_ENCRYPT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when the application is served over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="mti.communication@merdekabattery.com"
MAIL_FROM_NAME="MTI Employee Communication"
# MAIL_MAILER=microsoft-graph sends through Microsoft Graph from the MAIL_FROM_ADDRESS mailbox with an Entra
# app registration that has the Mail.Send application permission (no mailbox password). Empty MAIL_GRAPH_*
# use the MS_GRAPH_* registration. MAIL_GRAPH_SAVE_TO_SENT_ITEMS=true keeps a copy in its Sent Items.
MAIL_GRAPH_TENANT_ID=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CLIENT_SECRET=
MAIL_GRAPH_SAVE_TO_SENT_ITEMS=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --------------------------------------------------------------------------
# Merdeka application
# --------------------------------------------------------------------------
MERDEKA_APP_NAME="${APP_NAME}"
MERDEKA_APP_TAGLINE="Your Voice Shapes Our Collective Future"
# Role for job titles matching no role rule and for new SSO / LDAP accounts (3 = Employee).
MERDEKA_DEFAULT_ROLE_ID=3

# --------------------------------------------------------------------------
# Sign in: SSO and the network account (LDAP) only - no local passwords.
# The Microsoft button is always shown ("Coming soon" until the client id and
# secret below are filled); the Google button appears once it is configured.
# --------------------------------------------------------------------------
# Microsoft Entra ID / Azure AD (Merdeka Battery Materials). App registration:
#  - Redirect URI (Web): https://<your-host>/auth/microsoft/callback
#  - API permission: Microsoft Graph > User.Read (delegated)
#  - AZURE_TENANT_ID: the directory (tenant) id, or "common" for multi-tenant
#  - Or the trilingual-docon names, which take precedence: MS_SSO_CLIENT_ID /
#    MS_SSO_CLIENT_SECRET / MS_SSO_TENANT_ID (else MS_GRAPH_*) and
#    MS_SSO_REDIRECT_URI (the full URL registered in Entra)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI=/auth/microsoft/callback
# AZURE_PROXY=

# Google Workspace (Merdeka Copper Gold)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

# Network account (LDAP / Active Directory), same directory and settings as the
# trilingual-docon application. The bind account only needs read access: it
# looks the person up, then their own password is checked by binding as them.
# The sign-in form shows "Coming soon" until LDAP_URL and LDAP_BIND_DN are set.
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# The narrowest unit holding everyone who may sign in (not the domain root).
LDAP_USER_SEARCH_BASE=
LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
LDAP_TIMEOUT=5
# Verify the domain controller certificate (ldaps://). false only when its
# internal CA is not trusted here: the password could then be intercepted.
LDAP_TLS_VERIFY=true

# Accounts are matched on the company email (LDAP: mail, else
# userPrincipalName). Unknown people of the allowed domains are registered as
# Employee on their first SSO or network sign-in when auto register is on.
SSO_AUTO_REGISTER=true
SSO_ALLOWED_DOMAINS=merdekabattery.com,merdekacoppergold.com

# --------------------------------------------------------------------------
# Survey
# --------------------------------------------------------------------------
# Results of a group are only shown from this number of responses.
SURVEY_MIN_GROUP_SIZE=5
# Companies whose every employee fills in the surveys, besides the employees of the
# assessed departments (codes, comma separated).
SURVEY_RESPONDENT_COMPANIES=MTI
# Days before the end date to remind employees who have not completed a survey
# (in-app + email, sent daily at 08:00 by the scheduler), e.g. "14" or "14,7,1".
SURVEY_REMINDER_DAYS=14

# --------------------------------------------------------------------------
# Database seeding
# --------------------------------------------------------------------------
# Company email of the first IT Admin (highest role, only given by hand), who signs in
# with Microsoft SSO or that network account (php artisan db:seed --class=UserSeeder).
SEED_ADMIN_EMAIL=
# Demo employees and anonymous responses (never seeded in production).
SEED_DEMO_DATA=false

# Employee photos from the access card system (CardDB table, read only), taken during the
# daily employee import. Same server and account as DB_* unless CARD_DB_* say otherwise;
# empty: no photos.
CARD_DB_DATABASE=
