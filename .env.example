APP_NAME="Employee Satisfaction Survey"
APP_ENV=local
APP_KEY=
# Always false in production.
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Merdeka internal monitoring (activity_logs / error_logs tables)
LOG_ACTIVITY_ENABLED=true
LOG_ERRORS_TO_DATABASE=true

# SQLite works out of the box; SQL Server (sqlsrv, port 1433), MySQL/MariaDB and
# PostgreSQL are supported too.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lara_satisfaction
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when the application is served over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --------------------------------------------------------------------------
# Merdeka application
# --------------------------------------------------------------------------
MERDEKA_APP_NAME="${APP_NAME}"
MERDEKA_APP_TAGLINE="Your Voice Shapes Our Collective Future"
MERDEKA_APP_VERSION=1.0.0
# Role given to accounts created automatically through SSO (3 = Employee).
MERDEKA_DEFAULT_ROLE_ID=3

# --------------------------------------------------------------------------
# Single Sign-On
# The Microsoft button is always shown ("Coming soon" until the client id and
# secret below are filled); the Google button appears once it is configured.
# --------------------------------------------------------------------------
# Microsoft Entra ID / Azure AD (Merdeka Battery Materials). App registration:
#  - Redirect URI (Web): https://<your-host>/auth/microsoft/callback
#  - API permission: Microsoft Graph > User.Read (delegated)
#  - AZURE_TENANT_ID: the directory (tenant) id, or "common" for multi-tenant
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI=/auth/microsoft/callback
# AZURE_PROXY=

# Google Workspace (Merdeka Copper Gold)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

# Create unknown SSO users (allowed domains only) with the default role.
SSO_AUTO_REGISTER=false
SSO_ALLOWED_DOMAINS=merdekabattery.com,merdekacoppergold.com

# --------------------------------------------------------------------------
# Survey
# --------------------------------------------------------------------------
# Results of a group are only shown from this number of responses.
SURVEY_MIN_GROUP_SIZE=5
# Days before the end date to remind employees who have not completed a survey
# (in-app + email, sent daily at 08:00 by the scheduler), e.g. "14" or "14,7,1".
SURVEY_REMINDER_DAYS=14

# --------------------------------------------------------------------------
# Database seeding
# --------------------------------------------------------------------------
SEED_ADMIN_EMAIL=superadmin@merdekabattery.com
# Leave empty to generate a random password (printed by the seeder).
SEED_ADMIN_PASSWORD=
# Demo employees and anonymous responses (never seeded in production).
SEED_DEMO_DATA=false
